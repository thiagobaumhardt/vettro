DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-secret-troque-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=vettro_django
DB_USER=vettro
DB_PASSWORD=vettro
DB_HOST=localhost
DB_PORT=5433

# WhatsApp (Cloud API da Meta) — sem estas, o backend console só loga
# WHATSAPP_BACKEND=apps.whatsapp.backends.WhatsAppMetaCloudBackend
# META_APP_ID=
# META_APP_SECRET=
# META_EMBEDDED_SIGNUP_CONFIG_ID=
# META_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_CHAVE_CRIPTO=

# Maquininha integrada (Vero Cliente PDV) — sem estas, o sandbox aprova sozinho
# (passo a passo em ../docs/maquininha-vero.md)
# TEF_BACKEND=apps.pagamentos.tef.VeroClientePDVBackend
# VERO_PDV_TOKEN=
# VERO_CNPJ_CREDENCIADORA=92.934.215/0001-06
# VERO_IMPRIMIR_COMPROVANTE=True

# NFS-e no Emissor Nacional — liga pelo certificado A1 cadastrado em Clínica
# (passo a passo em ../docs/nfse-nacional.md). Só se precisar de CA extra:
# NFSE_NACIONAL_CA_BUNDLE=

# Responsável técnico nas NFC-e (quem desenvolve o Vettro — Data Dexter Ltda)
# RESP_TECNICO_CNPJ=54894646000199
# RESP_TECNICO_CONTATO=
# RESP_TECNICO_EMAIL=
# RESP_TECNICO_FONE=
